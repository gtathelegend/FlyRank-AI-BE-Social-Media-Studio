# Application Configuration
PORT=3000
NODE_ENV=development

# Social Publisher Configuration
# Options: discord | mock_x | mock_linkedin
SOCIAL_ADAPTER=discord

# Discord Integration (REQUIRED for real Discord publishing)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=social_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_studio

# Redis Configuration (Optional for BullMQ integration)
REDIS_HOST=localhost
REDIS_PORT=6379

# Durable Scheduler Worker Configuration
PROCESSING_LEASE_SECONDS=60
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=10
